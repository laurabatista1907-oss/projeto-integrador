int leds[] = {3, 5, 6, 9, 10, 11};
int buttonPin = 2;

int modo = 0;

bool estadoBotao = HIGH;
bool ultimoEstado = HIGH;

// ======================
void setup() {
  for (int i = 0; i < 6; i++) {
    pinMode(leds[i], OUTPUT);
  }
  pinMode(buttonPin, INPUT_PULLUP);
}

// ======================
void loop() {

  estadoBotao = digitalRead(buttonPin);

  // DETECTA APENAS O CLIQUE
  if (ultimoEstado == HIGH && estadoBotao == LOW) {
    modo++;
    if (modo > 3) modo = 0;
    delay(200); // debounce
  }

  ultimoEstado = estadoBotao;

  // ======================
  // MODOS
  // ======================

  // DESLIGADO
  if (modo == 0) {
    for (int i = 0; i < 6; i++) {
      analogWrite(leds[i], 0);
    }
  }

  // SUAVE
  else if (modo == 1) {
    for (int i = 0; i < 6; i++) {
      analogWrite(leds[i], 60);
    }
  }

  // MÉDIO
  else if (modo == 2) {
    for (int i = 0; i < 6; i++) {
      analogWrite(leds[i], 230);
    }
  }

  // PULSANTE
  else if (modo == 3) {
    for (int i = 0; i < 6; i++) {
      analogWrite(leds[i], 255);
    }
    delay(300);

    for (int i = 0; i < 6; i++) {
      analogWrite(leds[i], 0);
    }
    delay(300);
  }
}
